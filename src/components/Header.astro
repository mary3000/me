---
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const path = Astro.url.pathname.replace(/\/+$/, "") || "/"
const links = [
	[base, "about"],
	[base + "cv", "cv"],
	[base + "drawings", "drawings"],
	[base + "programming", "programming"],
]
---
<header class="border-b border-[var(--line)]"><div class="header-glass mx-auto flex max-w-6xl items-center justify-between px-6 py-5"><a href={base} class="text-lg font-extrabold">feof<span class="text-[var(--coral)]">.</span></a><nav class="flex gap-1 sm:gap-3">{links.map(([href,label])=><a href={href} class:list={["rounded-full px-3 py-1 text-sm font-semibold",{"text-[var(--coral)]":path === href.replace(/\/+$/, "") || (href === base && path === "/")}]}> {label}</a>)}</nav></div></header>
