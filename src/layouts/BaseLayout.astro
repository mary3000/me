---
import Header from "../components/Header.astro"
import "../styles/global.css"
const {title}=Astro.props
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · Maria Feofanova</title></head><body><Header/><img class="dragon-parallax" src={`${base}gallery/dragon.png`} alt="" aria-hidden="true" onerror="this.remove()"/><main><slot/></main></body></html>
<script>
	const dragon = document.querySelector<HTMLImageElement>('.dragon-parallax');
	if (dragon) {
		let ticking = false;
		const updateDragon = () => {
			dragon.style.transform = `translate3d(0, ${window.scrollY * -0.25}px, 0)`;
			ticking = false;
		};
		window.addEventListener('scroll', () => {
			if (!ticking) {
				window.requestAnimationFrame(updateDragon);
				ticking = true;
			}
		}, { passive: true });
	}
</script>
