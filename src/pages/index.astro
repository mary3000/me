---
import BaseLayout from "../layouts/BaseLayout.astro"
---
<BaseLayout title="About">
  <section class="border-b border-[var(--line)]">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-24 lg:grid-cols-[1.2fr_.8fr] lg:items-end">
      <div>
        <h1 class="page-title">Hello, I am<br />Maria Feofanova<span class="text-[var(--coral)]">.</span></h1>
        <p class="welcome-label mt-5">Welcome to my personal website</p>
        <p class="body-copy mt-10 text-lg text-[var(--muted)]">Backend Software Engineer, Artist and Dancer, and just a Curious Person. Feel free to contact me about anything!</p>
      </div>
      <div class="lg:pt-12"></div>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-6 py-20">
    <p class="eyebrow">Contacts</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a class="body-copy inline-flex items-center justify-between rounded-full border border-[var(--line)] bg-white/60 px-4 py-3 text-sm font-medium text-[var(--text)] transition-colors hover:border-[var(--coral)] hover:text-[var(--coral)]" href="https://github.com/mary3000">GitHub ↗</a>
      <a class="body-copy inline-flex items-center justify-between rounded-full border border-[var(--line)] bg-white/60 px-4 py-3 text-sm font-medium text-[var(--text)] transition-colors hover:border-[var(--coral)] hover:text-[var(--coral)]" href="https://www.linkedin.com/in/sham42/">LinkedIn ↗</a>
      <a class="body-copy inline-flex items-center justify-between rounded-full border border-[var(--line)] bg-white/60 px-4 py-3 text-sm font-medium text-[var(--text)] transition-colors hover:border-[var(--coral)] hover:text-[var(--coral)]" href="https://t.me/sham42">Telegram ↗</a>
      <a class="body-copy inline-flex items-center justify-between rounded-full border border-[var(--line)] bg-white/60 px-4 py-3 text-sm font-medium text-[var(--text)] transition-colors hover:border-[var(--coral)] hover:text-[var(--coral)]" href="https://www.instagram.com/sham.42/">Instagram ↗</a>
      <a class="body-copy inline-flex items-center justify-between rounded-full border border-[var(--line)] bg-white/60 px-4 py-3 text-sm font-medium text-[var(--text)] transition-colors hover:border-[var(--coral)] hover:text-[var(--coral)]" href="mailto:mary.fifa3000@gmail.com">Email ↗</a>
      <a class="body-copy inline-flex items-center justify-between rounded-full border border-[var(--line)] bg-white/60 px-4 py-3 text-sm font-medium text-[var(--text)] transition-colors hover:border-[var(--coral)] hover:text-[var(--coral)]" href="https://substack.com/@mariiafeofanova">Substack ↗</a>
    </div>
  </section>
</BaseLayout>
